<div class="ui middle aligned center aligned grid" style="height: 85vh;">
  <div class="column" style="max-width: 450px;">
    <h2 class="ui teal image header">
      <img src="/logo.svg" class="image" alt="MailerAction logo">
      <div class="content"><%= t("registration.title") %></div>
    </h2>
    <form class="ui large form <%= @user&.errors&.any? ? "error" : "" %>" action="/signup" method="post">
      <div class="ui stacked segment">
        <div class="field">
          <label><%= t("registration.name") %></label>
          <input type="text" name="user[name]" placeholder="<%= t('registration.name') %>" required value="<%= params.dig(:user, :name) %>">
        </div>
        <div class="field">
          <label><%= t("registration.email") %></label>
          <input type="email" name="user[email]" placeholder="<%= t('registration.email') %>" required value="<%= params.dig(:user, :email) %>">
        </div>
        <div class="field">
          <label><%= t("registration.password") %></label>
          <input type="password" name="user[password]" placeholder="••••••••" required>
        </div>
        <div class="field">
          <label><%= t("registration.password_confirmation") %></label>
          <input type="password" name="user[password_confirmation]" placeholder="••••••••" required>
        </div>
        <button type="submit" class="ui fluid large teal button"><%= t("registration.signup_button") %></button>
      </div>

      <% if @user && @user.errors.any? %>
        <div class="ui error message">
          <div class="header"><%= t("registration.error_heading") %></div>
          <ul class="list">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </form>

    <div class="ui message">
      <%= t("registration.already_have_account") %> <a href="/login"><%= t("registration.login") %></a>
    </div>
  </div>
</div>
