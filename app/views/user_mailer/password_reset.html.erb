<!-- app/views/user_mailer/password_reset.html.erb -->
<div style="max-width: 480px; margin: 0 auto; padding: 32px; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.09); background: #fff;">
  <img src="https://maileraction.com/logo.svg" alt="MailerAction" width="90" style="margin-bottom: 24px;">
  <h2 style="color: #03c3ec; margin-bottom: 8px;">
    <%= t("reset_password.saludo", name: @user.name || "Usuario") %>
  </h2>
  <p style="margin-bottom: 24px;">
    <%= t("reset_password.intro") %>
  </p>
  <div style="text-align: center; margin-bottom: 24px;">
    <a href="<%= @url %>" style="display: inline-block; background: #03c3ec; color: #fff; padding: 12px 32px; border-radius: 6px; text-decoration: none; font-size: 16px; font-weight: 600;">
      <%= t("reset_password.boton") %>
    </a>
  </div>
  <p style="font-size: 14px; color: #999;">
    <%= t("reset_password.aviso") %>
  </p>
  <p style="margin-top: 32px;">
    <%= t("reset_password.despedida") %>
  </p>
</div>
